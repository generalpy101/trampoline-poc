# nginx reverse proxy in front of gunicorn.
# Drop into /etc/nginx/sites-available/delivery-estimate, symlink to
# sites-enabled, and `sudo nginx -t && sudo systemctl reload nginx`.
#
# TLS certs assumed to be from certbot (Let's Encrypt). To get them:
#   sudo certbot --nginx -d your-domain.com

server {
    listen 80;
    listen [::]:80;
    server_name your-domain.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name your-domain.com;

    ssl_certificate     /etc/letsencrypt/live/your-domain.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/your-domain.com/privkey.pem;

    # Reasonable defaults; tweak to taste.
    client_max_body_size 4M;
    keepalive_timeout 65;

    # Static files: let nginx serve them directly.
    # Faster than going through gunicorn / WhiteNoise.
    location /static/ {
        alias /var/www/delivery-estimate/staticfiles/;
        access_log off;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # App
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        proxy_redirect off;
    }
}
