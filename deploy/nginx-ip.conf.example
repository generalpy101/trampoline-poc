# HTTP-only nginx reverse proxy for IP-based deployments (no domain, no TLS).
# Drop into /etc/nginx/sites-available/delivery-estimate, symlink to
# sites-enabled, and `sudo nginx -t && sudo systemctl reload nginx`.
#
# When you later get a domain, switch to nginx.conf.example and run certbot.

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;          # match any hostname or IP

    client_max_body_size 4M;
    keepalive_timeout 65;

    # Static files: served directly by nginx.
    location /static/ {
        alias /var/www/delivery-estimate/staticfiles/;
        access_log off;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # App
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        proxy_redirect off;
    }
}
