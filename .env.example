# Production environment variables.
# On the VPS, this lives at /etc/delivery-estimate.env (mode 640,
# owned by root:delivery) and is loaded by systemd via EnvironmentFile=.
# Never commit the real .env file (already in .gitignore).

# ----- Django core -----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=your-domain.com,www.your-domain.com

# Set to false if nginx (or another reverse proxy) already terminates TLS
# and the app shouldn't double-redirect. Keep true if gunicorn faces the
# internet directly.
DJANGO_SSL_REDIRECT=false

# ----- Database -----
# Absolute path to the SQLite file. Use a directory the `delivery` user
# can write to (matches ReadWritePaths in the systemd unit).
SQLITE_PATH=/var/lib/delivery-estimate/db.sqlite3

# ----- Cache (optional) -----
# Redis recommended only for multi-instance deploys. Single-VPS deploys
# can leave this unset — in-memory cache works fine.
# REDIS_URL=redis://localhost:6379/0

# ----- App tuning (optional) -----
DELIVERY_PROMISE_PERCENTILE=0.80
HANDLING_BUFFER_DAYS=1
MIN_SAMPLES_FOR_LANE=10
DEFAULT_TRANSIT_DAYS=10

# ----- Gunicorn (optional) -----
# Sized for SQLite + a single VPS. Bump workers if your traffic is
# read-heavy and you have CPU headroom.
WEB_CONCURRENCY=2
WEB_THREADS=4
GUNICORN_TIMEOUT=30
GUNICORN_LOG_LEVEL=info
PORT=8000
